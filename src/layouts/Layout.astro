---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { useTranslations } from '../i18n/index';

interface HreflangAlternate {
  lang: string;
  url: string;
}

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  additionalSchemas?: Record<string, unknown>[];
  lang?: 'de' | 'tr';
  hreflangAlternates?: HreflangAlternate[];
  lastUpdated?: string;
}

const {
  title,
  description,
  ogImage = '/therapy/og-logopaedie-simsek-duisburg.webp',
  additionalSchemas = [],
  lang = 'de',
  hreflangAlternates = [],
  lastUpdated = '2026-04-23',
} = Astro.props;

const siteUrl = 'https://logopaedie-simsek.de';
const normalizeAbsoluteUrl = (url: string) => {
  const absoluteUrl = url.startsWith('http')
    ? url
    : `${siteUrl}${url.startsWith('/') ? '' : '/'}${url}`;
  const parsedUrl = new URL(absoluteUrl);

  if (!parsedUrl.pathname.includes('.') && !parsedUrl.pathname.endsWith('/')) {
    parsedUrl.pathname = `${parsedUrl.pathname}/`;
  }

  return parsedUrl.toString();
};

const canonicalUrl = normalizeAbsoluteUrl(`${siteUrl}${Astro.url.pathname}`);
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;
const ogLocale = lang === 'tr' ? 'tr_TR' : 'de_DE';
const alternateOgLocale = lang === 'tr' ? 'de_DE' : 'tr_TR';
const inLanguage = lang === 'tr' ? 'tr-DE' : 'de-DE';
const normalizedHreflangAlternates = hreflangAlternates.map((alt) => ({
  ...alt,
  url: normalizeAbsoluteUrl(alt.url),
}));
const translations = useTranslations(lang);
const s = translations.schema;
const skipLabel = translations.a11y.skip_to_content;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      "url": `${siteUrl}/`,
      "name": "Praxis für Logopädie Şimşek",
      "inLanguage": ["de-DE", "tr-DE"],
      "publisher": { "@id": `${siteUrl}/#business` }
    },
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      "url": canonicalUrl,
      "name": title,
      "description": description,
      "inLanguage": inLanguage,
      "isPartOf": { "@id": `${siteUrl}/#website` },
      "about": { "@id": `${siteUrl}/#business` },
      "publisher": { "@id": `${siteUrl}/#business` },
      "reviewedBy": {
        "@type": "Person",
        "name": "Emel Şimşek-Uçar",
        "jobTitle": s.founder_title
      },
      "primaryImageOfPage": ogImageUrl,
      "dateModified": lastUpdated
    },
    {
      "@type": ["LocalBusiness", "MedicalBusiness"],
      "@id": `${siteUrl}/#business`,
      "name": "Praxis für Logopädie Şimşek",
      "description": s.business_description,
      "url": `${siteUrl}/`,
      "telephone": "+4920334868690",
      "faxNumber": "+4920334868691",
      "email": "info@logopaedie-simsek.de",
      "image": `${siteUrl}/logo.png`,
      "logo": `${siteUrl}/logo.png`,
      "hasMap": "https://maps.app.goo.gl/yNSy6v8qxmapZZwJ9",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Tonhallenstraße 21",
        "addressLocality": "Duisburg",
        "postalCode": "47051",
        "addressCountry": "DE"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 51.430147,
        "longitude": 6.764742
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          "opens": "08:00",
          "closes": "18:00"
        }
      ],
      "priceRange": "€€",
      "paymentAccepted": "Kassenrezept, Privatrezept, Selbstzahler",
      "availableLanguage": [
        { "@type": "Language", "name": "German" },
        { "@type": "Language", "name": "Turkish" }
      ],
      "areaServed": {
        "@type": "City",
        "name": "Duisburg"
      },
      "founder": {
        "@type": "Person",
        "name": "Emel Şimşek-Uçar",
        "jobTitle": s.founder_title
      },
      "sameAs": [
        "https://www.facebook.com/logopaediesimsek/",
        "https://maps.app.goo.gl/yNSy6v8qxmapZZwJ9",
        "https://xn--logopdiejobs-kcb.de/"
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": s.offer_catalog_name,
        "itemListElement": s.services.map(sv => ({
          "@type": "Offer",
          "itemOffered": { "@type": "Service", "name": sv.name, "url": normalizeAbsoluteUrl(sv.url) }
        }))
      }
    }
  ]
};
---
<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- hreflang alternates -->
    {normalizedHreflangAlternates.map(alt => (
      <link rel="alternate" hreflang={alt.lang} href={alt.url} />
    ))}

    <!-- Favicons -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#2a7f6f" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={alternateOgLocale} />
    <meta property="og:site_name" content="Praxis für Logopädie Şimşek" />
    <meta property="article:modified_time" content={lastUpdated} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="author" content="Praxis für Logopädie Şimşek" />
    <meta name="geo.region" content="DE-NW" />
    <meta name="geo.placename" content="Duisburg" />
    <meta name="geo.position" content="51.430147;6.764742" />
    <meta name="ICBM" content="51.430147, 6.764742" />

    <!-- JSON-LD Structured Data -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {additionalSchemas.map(schema => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <!-- robots -->
    <meta name="robots" content={
      ['/impressum', '/datenschutz', '/barrierefreiheit'].some(p => Astro.url.pathname.startsWith(p))
        ? 'noindex, nofollow'
        : 'index, follow'
    } />

    <!-- Without JS the reveal animation must never hide content -->
    <noscript>
      <style>
        .reveal { opacity: 1 !important; transform: none !important; }
      </style>
    </noscript>

    <!-- Vercel Web Analytics (cookielos; wird aktiv, sobald Analytics im Vercel-Dashboard aktiviert ist) -->
    <script defer src="/_vercel/insights/script.js"></script>

    <!-- View Transitions: eliminates page-reload flash on navigation -->
    <ClientRouter />
  </head>
  <body>
    <a href="#main-content" class="skip-link">{skipLabel}</a>
    <slot />
    <script>
      function restoreLandmarkVisibility() {
        document.querySelectorAll('#site-header[aria-hidden="true"], #site-nav[aria-hidden="true"], main[aria-hidden="true"], footer[aria-hidden="true"]').forEach(el => {
          el.removeAttribute('aria-hidden');
        });
      }

      function initLandmarkGuard() {
        restoreLandmarkVisibility();

        if (document.documentElement.dataset.landmarkGuardReady === 'true') return;
        document.documentElement.dataset.landmarkGuardReady = 'true';

        const observer = new MutationObserver((mutations) => {
          for (const mutation of mutations) {
            if (mutation.type === 'attributes' && mutation.attributeName === 'aria-hidden') {
              restoreLandmarkVisibility();
              break;
            }
          }
        });

        observer.observe(document.body, {
          attributes: true,
          subtree: true,
          attributeFilter: ['aria-hidden'],
        });
      }

      // Elements still waiting to be revealed (re-collected on every navigation)
      let pendingReveals: Set<Element> = new Set();

      function initPage() {
        initLandmarkGuard();

        // Scroll Reveal
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('reveal-visible');
              pendingReveals.delete(entry.target);
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
        pendingReveals = new Set(document.querySelectorAll('.reveal:not(.reveal-visible)'));
        pendingReveals.forEach(el => observer.observe(el));

        // Fallback: fast flick-scrolling can cross the whole viewport between
        // two observer callbacks, so those entries never report isIntersecting.
        // Reveal anything whose top has passed the viewport bottom.
        if (document.documentElement.dataset.revealFallbackReady !== 'true') {
          document.documentElement.dataset.revealFallbackReady = 'true';
          let ticking = false;
          const revealPassed = () => {
            ticking = false;
            pendingReveals.forEach(el => {
              if (el.getBoundingClientRect().top < window.innerHeight - 40) {
                el.classList.add('reveal-visible');
                pendingReveals.delete(el);
              }
            });
          };
          window.addEventListener('scroll', () => {
            if (!ticking && pendingReveals.size) {
              ticking = true;
              requestAnimationFrame(revealPassed);
            }
          }, { passive: true });
        }

        document.querySelectorAll('[data-google-map-load]').forEach(button => {
          if (button instanceof HTMLButtonElement && button.dataset.ready !== 'true') {
            button.dataset.ready = 'true';
            button.addEventListener('click', () => {
              const wrapper = button.closest('[data-google-map]');
              const iframe = wrapper?.querySelector('iframe[data-src]');
              if (iframe instanceof HTMLIFrameElement && iframe.dataset.src) {
                iframe.src = iframe.dataset.src;
                iframe.removeAttribute('hidden');
                button.closest('[data-google-map-placeholder]')?.setAttribute('hidden', '');
              }
            });
          }
        });
      }

      document.addEventListener('astro:page-load', initPage);
    </script>
  </body>
</html>
