---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';
import emelImg from '../assets/therapy/team-emel-simsek-ucar-grid.jpg';
import maraImg from '../assets/therapy/team-mara-niessalla-grid.jpg';
import kristinaImg from '../assets/therapy/team-kristina-imping-grid.jpg';
import seymaImg from '../assets/therapy/team-seyma-bozoglan-grid.jpg';

const siteUrl = 'https://logopaedie-simsek.de';

// ── Team-Datenmodell ──
// Jedes Mitglied definiert alle für die Kachel + das Schema.org-Person-Objekt
// nötigen Felder an einer Stelle. Neue Kolleginnen werden ergänzt, indem hier
// ein weiteres Objekt ins Array eingefügt wird (Foto-Import + Slug + reale
// Fachdaten vorausgesetzt) — das Grid und die Schema-Generierung passen sich
// automatisch an, kein weiterer Code muss angefasst werden.
type TeamMember = {
  slug: string;
  name: string;
  jobTitle: string;
  roleBadge: string;
  isLead: boolean;
  img: ImageMetadata;
  imgAlt: string;
  loading: 'eager' | 'lazy';
  tags: string[];
  schema: {
    description: string;
    hasOccupation: Record<string, unknown>;
    knowsLanguage?: Record<string, unknown>[];
    address?: Record<string, unknown>;
  };
};

const members: TeamMember[] = [
  {
    slug: 'emel-simsek-ucar',
    name: 'Emel Şimşek-Uçar',
    jobTitle: 'Staatlich anerkannte Logopädin',
    roleBadge: 'Logopädin',
    isLead: true,
    img: emelImg,
    imgAlt: 'Emel Şimşek-Uçar – Logopädin in der Praxis für Logopädie Şimşek Duisburg',
    loading: 'eager',
    tags: ['Deutsch & Türkçe', '10+ Jahre Erfahrung', 'Kinder & Erwachsene'],
    schema: {
      description: 'Staatlich anerkannte Logopädin und Gründerin der Praxis für Logopädie Şimşek in Duisburg. Spezialisiert auf zweisprachige Diagnostik und Therapie auf Deutsch und Türkisch. Mehr als 10 Jahre klinische Erfahrung in der Sprachtherapie für Kinder und Erwachsene.',
      knowsLanguage: [
        { '@type': 'Language', name: 'German' },
        { '@type': 'Language', name: 'Turkish' },
      ],
      hasOccupation: {
        '@type': 'Occupation',
        name: 'Logopädin',
        occupationalCategory: 'Therapeutin',
        skills: 'Sprachtherapie, Stimmtherapie, Dysphagietherapie, Frühförderung, Aphasietherapie, Zweisprachige Diagnostik',
      },
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Tonhallenstraße 21',
        addressLocality: 'Duisburg',
        postalCode: '47051',
        addressCountry: 'DE',
      },
    },
  },
  {
    slug: 'mara-niessalla',
    name: 'Mara Nießalla',
    jobTitle: 'Staatlich anerkannte Logopädin',
    roleBadge: 'Logopädin',
    isLead: false,
    img: maraImg,
    imgAlt: 'Mara Nießalla – Logopädin in der Praxis für Logopädie Şimşek Duisburg',
    loading: 'lazy',
    tags: ['Erwachsene', 'Hausbesuche bei Bedarf', 'Kinder & Jugendliche'],
    schema: {
      description: 'Staatlich anerkannte Logopädin in der Praxis für Logopädie Şimşek in Duisburg. Überwiegend Erwachsenentherapie, Hausbesuche bei Bedarf und auch Therapie für Kinder und Jugendliche.',
      hasOccupation: {
        '@type': 'Occupation',
        name: 'Logopädin',
        occupationalCategory: 'Therapeutin',
        skills: 'Erwachsenentherapie, Hausbesuche, Kindersprachtherapie, Diagnostik, Therapieplanung',
      },
    },
  },
  {
    slug: 'kristina-imping',
    name: 'Kristina Imping',
    jobTitle: 'Staatlich anerkannte Logopädin',
    roleBadge: 'Logopädin',
    isLead: false,
    img: kristinaImg,
    imgAlt: 'Kristina Imping – Logopädin in der Praxis für Logopädie Şimşek Duisburg',
    loading: 'lazy',
    tags: ['Tiergestützte Therapie', 'Fütterstörungen', 'Langjährige Erfahrung'],
    schema: {
      description: 'Staatlich anerkannte Logopädin in der Praxis für Logopädie Şimşek in Duisburg. Kristina Imping ist auf tiergestützte Therapie und die Behandlung von Fütterstörungen spezialisiert und bringt langjährige klinische Erfahrung mit.',
      hasOccupation: {
        '@type': 'Occupation',
        name: 'Logopädin',
        occupationalCategory: 'Therapeutin',
        skills: 'Tiergestützte Therapie, Fütterstörungen',
      },
    },
  },
  {
    slug: 'seyma-bozoglan',
    name: 'Şeyma Bozoğlan',
    jobTitle: 'Staatlich anerkannte Logopädin',
    roleBadge: 'Logopädin',
    isLead: false,
    img: seymaImg,
    imgAlt: 'Şeyma Bozoğlan – Logopädin in der Praxis für Logopädie Şimşek Duisburg',
    loading: 'lazy',
    tags: ['Deutsch & Türkçe', 'Kindersprache', 'Aphasie'],
    schema: {
      description: 'Staatlich anerkannte Logopädin in der Praxis für Logopädie Şimşek in Duisburg. Şeyma Bozoğlan behandelt zweisprachig auf Deutsch und Türkisch, beide auf Muttersprachniveau, mit den Schwerpunkten Kindersprachtherapie und Aphasietherapie.',
      knowsLanguage: [
        { '@type': 'Language', name: 'German' },
        { '@type': 'Language', name: 'Turkish' },
      ],
      hasOccupation: {
        '@type': 'Occupation',
        name: 'Logopädin',
        occupationalCategory: 'Therapeutin',
        skills: 'Kindersprachtherapie, Aphasietherapie, Zweisprachige Diagnostik',
      },
    },
  },
];

const leadMember = members.find((m) => m.isLead) ?? members[0];

const teamSchemas = members.map((member) => ({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: member.name,
  jobTitle: member.jobTitle,
  url: `${siteUrl}/team/`,
  description: member.schema.description,
  worksFor: {
    '@type': 'MedicalOrganization',
    name: 'Praxis für Logopädie Şimşek',
    url: siteUrl,
  },
  ...(member.schema.knowsLanguage ? { knowsLanguage: member.schema.knowsLanguage } : {}),
  hasOccupation: member.schema.hasOccupation,
  ...(member.schema.address ? { address: member.schema.address } : {}),
}));

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Startseite", "item": `${siteUrl}/` },
    { "@type": "ListItem", "position": 2, "name": "Team", "item": `${siteUrl}/team/` }
  ]
};
---

<Layout
  title="Unser Team – Praxis für Logopädie Şimşek Duisburg"
  description="Emel Şimşek-Uçar, Mara Nießalla, Kristina Imping und Şeyma Bozoğlan – das Logopädinnen-Team der Praxis für Logopädie Şimşek in Duisburg. Zweisprachige Logopädie auf Deutsch und Türkisch, über 10 Jahre Erfahrung."
  additionalSchemas={[...teamSchemas, breadcrumbSchema]}
  hreflangAlternates={[
    { lang: 'de', url: `${siteUrl}/team/` },
    { lang: 'tr', url: `${siteUrl}/ekip/` },
    { lang: 'x-default', url: `${siteUrl}/team/` },
  ]}
>
  <Header alternateUrl="/ekip" />
  <Nav alternateUrl="/ekip" />
  <main id="main-content" class="pt-[calc(var(--header-h)+var(--nav-h))]">

    <!-- Breadcrumb -->
    <nav class="bg-bg-alt border-b border-border" aria-label="Breadcrumb">
      <div class="container py-3">
        <ol class="flex items-center gap-2 text-sm text-text-muted flex-wrap" role="list">
          <li><a href="/" class="hover:text-primary transition-colors">Startseite</a></li>
          <li aria-hidden="true">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          </li>
          <li class="text-text font-medium" aria-current="page">Team</li>
        </ol>
      </div>
    </nav>

    <!-- Bento Grid -->
    <section class="container py-10 pb-16" aria-labelledby="team-heading">
      <h1 class="sr-only" id="team-heading">Unser Team – Praxis für Logopädie Şimşek Duisburg</h1>
      <div class="bento">

        <!-- ── Teammitglieder (datengetrieben, 2–4 gleichwertige Kacheln) ── -->
        <div class="bento-members" style={`--member-count: ${members.length};`}>
        {members.map((member) => (
          <article class="bento-member relative overflow-hidden rounded-(--radius-lg) group" aria-label={member.name}>
            <a href={`/team/${member.slug}/`} class="absolute inset-0 z-10" aria-label={`Zum Profil von ${member.name}`}></a>
            <Image
              src={member.img}
              alt={member.imgAlt}
              class="bento-member-img absolute inset-0 w-full h-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-[1.04]"
              widths={[480, 720, 960]}
              sizes="(max-width: 540px) 100vw, (max-width: 860px) 50vw, 40vw"
              loading={member.loading}
              decoding="async"
            />
            <!-- Gradient overlay -->
            <div class="absolute inset-0 bg-gradient-to-t from-[#1c1916]/70 via-[#1c1916]/15 to-transparent"></div>
            <!-- Badge -->
            <div class="absolute top-5 right-5 flex flex-col items-end gap-2">
              <span class="bg-primary text-white text-[.7rem] font-bold tracking-[.06em] uppercase px-3 py-1.5 rounded-full shadow-md">
                {member.roleBadge}
              </span>
            </div>
            <!-- Content overlay -->
            <div class="absolute bottom-0 left-0 right-0 p-6">
              <h2 class="font-display text-[1.3rem] font-semibold text-white leading-tight mb-1 whitespace-nowrap overflow-hidden text-ellipsis">
                {member.name}
              </h2>
              <div class="flex flex-col items-start gap-2">
                {member.tags.map((tag) => (
                  <span class="bg-white/15 backdrop-blur-sm text-white text-xs font-medium px-3 py-1.5 rounded-full border border-white/20">
                    {tag}
                  </span>
                ))}
              </div>
              <span class="mt-3 inline-flex items-center gap-1 text-white/70 text-xs font-semibold group-hover:text-white transition-colors relative z-20 pointer-events-none">
                Profil ansehen
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
              </span>
            </div>
          </article>
        ))}
        </div>

        <!-- ── Info-Karten (Titel, Stats, Sprachen, Zitat, Karriere-CTA) ── -->
        <div class="bento-info">

        <!-- ── Team-Info: Headline + Kennzahlen zusammengeführt ── -->
        <div class="bento-teaminfo rounded-(--radius-lg) p-8 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6" style="background: var(--color-primary-light);">
          <div>
            <span class="text-xs font-semibold tracking-[.12em] uppercase text-primary mb-3 block">Unser Team</span>
            <p class="font-display text-[clamp(1.75rem,2.6vw,2.25rem)] font-semibold text-text leading-[1.15] mb-2">
              Logopädie ist <em class="text-primary">Vertrauenssache.</em>
            </p>
            <p class="text-text-muted text-[0.9375rem] leading-relaxed max-w-md">
              Lernen Sie die Menschen kennen, die jeden Tag für bessere Kommunikation arbeiten.
            </p>
          </div>
          <div class="flex gap-8 shrink-0">
            <div>
              <div class="font-display text-[2.75rem] font-semibold text-primary leading-none">{members.length}</div>
              <div class="text-text-muted text-xs font-medium leading-snug mt-1">Logopädinnen<br>im Team</div>
            </div>
            <div>
              <div class="font-display text-[2.75rem] font-semibold text-primary leading-none">2</div>
              <div class="text-text-muted text-xs font-medium leading-snug mt-1">Sprachen auf<br>Muttersprachniveau</div>
            </div>
          </div>
        </div>

        <!-- ── Languages card ── -->
        <div class="bento-lang rounded-(--radius-lg) p-6 flex flex-col justify-center gap-4" style="background: var(--color-bg-alt);">
          <div class="flex gap-2.5 flex-wrap">
            <span class="bg-surface border border-border text-text font-semibold text-sm px-4 py-2.5 rounded-xl shadow-sm">
              🇩🇪&nbsp; Deutsch
            </span>
            <span class="bg-surface border border-border text-text font-semibold text-sm px-4 py-2.5 rounded-xl shadow-sm">
              🇹🇷&nbsp; Türkçe
            </span>
          </div>
          <p class="text-text-muted text-sm font-medium leading-relaxed">
            Diagnostik, Beratung und Therapie auf Deutsch und Türkisch.
          </p>
        </div>

        <!-- ── Philosophy quote ── -->
        <div class="bento-phil rounded-(--radius-lg) p-7 flex flex-col justify-center" style="background: var(--color-accent-light);">
          <svg class="mb-4 shrink-0 opacity-35" width="36" height="36" viewBox="0 0 24 24" fill="var(--color-accent)" aria-hidden="true">
            <path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1zm12 0c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z"/>
          </svg>
          <blockquote class="font-display text-[1.1875rem] font-medium italic text-text leading-relaxed mb-4">
            „Mehrsprachigkeit ist keine Hürde – sie ist eine Ressource."
          </blockquote>
          <cite class="text-sm font-semibold tracking-widest uppercase not-italic" style="color: var(--color-accent);">
            {leadMember.name}
          </cite>
        </div>

        <!-- ── Career CTA ── -->
        <a href="/karriere/" class="bento-cta rounded-(--radius-lg) p-6 flex flex-col justify-between text-white group transition-opacity hover:opacity-90" style="background: var(--color-accent);">
          <div>
            <span class="text-xs font-bold tracking-[.12em] uppercase text-white/80">Karriere</span>
            <h3 class="font-display text-[1.5rem] font-semibold text-white mt-2 leading-tight">
              Wir suchen<br>Verstärkung
            </h3>
            <p class="text-white/90 text-sm font-medium mt-2.5 leading-relaxed">
              Engagierte Logopäd:innen für unser Team in Duisburg gesucht.
            </p>
          </div>
          <div
            class="mt-5 inline-flex items-center justify-center gap-2 text-sm font-semibold rounded-xl px-4 py-3 transition-colors border border-white/30 group-hover:border-white/60"
            style="background: rgba(255,255,255,0.12);"
          >
            Stellenanzeige
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m9 18 6-6-6-6"/>
            </svg>
          </div>
        </a>

        </div>
      </div>
    </section>

    <!-- CTA Strip -->
    <div class="border-t border-border bg-bg-alt py-8">
      <div class="container flex flex-col sm:flex-row gap-3 sm:items-center sm:justify-between">
        <p class="text-text-muted text-sm">Fragen zu unserem Therapieangebot oder Terminanfragen?</p>
        <div class="flex flex-col sm:flex-row gap-3 shrink-0">
          <a href="/kontakt/" class="btn btn-primary justify-center">Termin anfragen</a>
          <a href="/therapie/" class="btn btn-ghost justify-center">Therapieangebot</a>
        </div>
      </div>
    </div>

  </main>
  <Footer />
</Layout>

<style>
  /*
   * ── Bento grid layout ──
   * Zwei getrennte Grids statt einer gemeinsamen `dense`-Packung: eine
   * Reihe gleich großer Personen-Kacheln, darunter eine eigene Reihe für
   * die 5 Inhalts-Kacheln (Titel/Stats/Sprachen/Zitat/CTA). Das hält beide
   * Bereiche unabhängig von der Mitgliederzahl (2–4) vorhersagbar — die
   * `dense`-Variante erzeugte bei 3–4 Personen Lücken und verschobene
   * Karten, weil unterschiedlich hohe Elemente sich gegenseitig blockierten.
   */
  .bento-members {
    display: grid;
    grid-template-columns: repeat(var(--member-count, 4), 1fr);
    gap: 12px;
    margin-bottom: 12px;
  }

  .bento-member {
    min-height: 460px;
  }

  .bento-info {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  .bento-teaminfo { grid-column: 1 / -1; }

  @media (max-width: 860px) {
    .bento-members {
      grid-template-columns: repeat(2, 1fr);
    }
    .bento-member {
      min-height: 340px;
    }
    .bento-info {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 540px) {
    .bento-members {
      grid-template-columns: 1fr;
    }
    .bento-member {
      min-height: 380px;
    }
    .bento-info {
      grid-template-columns: 1fr;
    }
  }

</style>
