---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import BewerbungForm from '../components/BewerbungForm.astro';

const siteUrl = 'https://logopaedie-simsek.de';
const applyHref = `mailto:info@logopaedie-simsek.de?subject=${encodeURIComponent('Unverbindliches Kennenlernen – Logopädie / Sprachtherapie')}&body=${encodeURIComponent('Hallo Frau Şimşek-Uçar,\n\nich interessiere mich für eine Stelle in Ihrer Praxis und würde Sie und das Team gern unverbindlich kennenlernen.\n\nViele Grüße\n')}`;

const jobSchema = {
  "@context": "https://schema.org",
  "@type": "JobPosting",
  "title": "Logopädin / Logopäde / Sprachtherapeutin / Sprachtherapeut (m/w/d)",
  "description": "<p>Die Praxis für Logopädie Şimşek sucht mehrere staatlich anerkannte und zugelassene Logopädinnen, Logopäden, Sprachtherapeutinnen und Sprachtherapeuten (m/w/d) für unbefristete Stellen in Duisburg.</p><p>Vollzeit umfasst 38,5 Wochenstunden; Teilzeit mit variablem Stundenumfang und eine Vier-Tage-Woche sind möglich. Die Vergütung beträgt je nach Erfahrung 22–26 EUR brutto pro Stunde, bei Vollzeit ungefähr 3.600–4.300 EUR brutto pro Monat. Zusätzlich wird jedes Jahr Weihnachtsgeld gezahlt.</p><p>Aufgaben sind Diagnostik und Therapie für Menschen aller Altersgruppen, Dokumentation, Berichte, Beratung und Organisation. Eigene fachliche Schwerpunkte sind erwünscht. Die Terminplanung erfolgt eigenständig auf Vertrauensbasis mit iPrax.</p><p>Vorausgesetzt werden eine staatlich anerkannte und zugelassene Ausbildung oder ein Studium in Logopädie beziehungsweise Sprachtherapie sowie sehr gute Deutschkenntnisse. Berufserfahrung, Türkischkenntnisse, Führerschein und fertige Spezialisierungen sind nicht erforderlich.</p>",
  "datePosted": "2026-08-09",
  "hiringOrganization": {
    "@type": "Organization",
    "name": "Praxis für Logopädie Şimşek",
    "url": siteUrl,
    "sameAs": [
      "https://www.facebook.com/logopaediesimsek/",
      "https://maps.app.goo.gl/yNSy6v8qxmapZZwJ9",
      "https://xn--logopdiejobs-kcb.de/"
    ],
    "logo": `${siteUrl}/logo.png`
  },
  "jobLocation": {
    "@type": "Place",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Tonhallenstraße 21",
      "addressLocality": "Duisburg",
      "postalCode": "47051",
      "addressRegion": "Nordrhein-Westfalen",
      "addressCountry": "DE"
    }
  },
  ...(import.meta.env.PUBLIC_WEB3FORMS_KEY ? { "directApply": true } : {}),
  "employmentType": ["FULL_TIME", "PART_TIME"],
  "baseSalary": {
    "@type": "MonetaryAmount",
    "currency": "EUR",
    "value": {
      "@type": "QuantitativeValue",
      "minValue": 22,
      "maxValue": 26,
      "unitText": "HOUR"
    }
  },
  "workHours": "Vollzeit 38,5 Stunden pro Woche; Teilzeit mit variablem Stundenumfang; Vier-Tage-Woche möglich",
  "industry": "Gesundheitswesen",
  "occupationalCategory": "29-1127.00",
  "jobBenefits": "30 Urlaubstage bei einer Fünf-Tage-Woche, Heiligabend und Silvester frei, jährliches Weihnachtsgeld, Fortbildungsunterstützung mit zusätzlichen freien Tagen, strukturierte Einarbeitung, iPad mit privater Nutzung, nach Möglichkeit Parkplatz, sonst Parkkostenunterstützung",
  "qualifications": "Staatlich anerkannte und zugelassene Logopädin, staatlich anerkannter und zugelassener Logopäde oder entsprechend anerkannte Sprachtherapie-Qualifikation nach Ausbildung oder Studium; sehr gute Deutschkenntnisse",
  "experienceRequirements": "Berufserfahrung ist nicht erforderlich; Berufsanfängerinnen und Berufsanfänger sind willkommen",
  "skills": "Eigene Schwerpunkte in Pädiatrie, Neurologie, Stottern, Poltern, Stimme, Aussprache oder weiteren logopädischen Bereichen sind willkommen und können nach Einstieg aufgebaut werden",
  "responsibilities": "Diagnostik und Therapie für Menschen aller Altersgruppen; Dokumentation, Berichte, Eltern- und Angehörigenberatung sowie organisatorische Aufgaben. Hausbesuche sind nur auf eigenen Wunsch möglich.",
  "employerOverview": "Praxis für Logopädie Şimşek in Duisburg mit vierköpfigem Team, flachen Hierarchien, wöchentlichem Erfahrungsaustausch und strukturierter Einarbeitung."
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Startseite", "item": `${siteUrl}/` },
    { "@type": "ListItem", "position": 2, "name": "Karriere", "item": `${siteUrl}/karriere/` }
  ]
};

const formLabels = {
  name: "Name",
  contact: "Telefon oder E-Mail",
  message: "Kurze Nachricht (optional)",
  submit: "Bewerbung absenden",
  sending: "Wird gesendet …",
  success_title: "Danke für deine Bewerbung!",
  success_text: "Danke! Wir melden uns persönlich bei dir.",
  error_text: "Das hat leider nicht geklappt. Bitte versuche es erneut oder schreib direkt an info@logopaedie-simsek.de.",
  privacy_before: "Mit dem Absenden stimmst du der Verarbeitung deiner Angaben zur Bearbeitung deiner Bewerbung zu. Details in der",
  privacy_link: "Datenschutzerklärung",
};

const benefits = [
  { icon: "💰", title: "22–26 € pro Stunde", desc: "Bei Vollzeit ungefähr 3.600–4.300 € brutto im Monat – zusätzlich wird jedes Jahr Weihnachtsgeld gezahlt." },
  { icon: "🏖️", title: "30 Urlaubstage", desc: "Bei fünf Arbeitstagen; anteilig bei weniger Tagen. Heiligabend und Silvester sind frei." },
  { icon: "🤝", title: "Intensive Einarbeitung", desc: "Dein Terminplan wächst schrittweise und eine Ansprechperson ist jederzeit für dich da." },
  { icon: "📚", title: "Fortbildungsunterstützung", desc: "Finanzielle Unterstützung, zusätzliche freie Tage und freie Auswahl deiner Fortbildungen." },
  { icon: "⏰", title: "Flexible Arbeitsmodelle", desc: "38,5 Stunden Vollzeit, variable Teilzeit und eine Vier-Tage-Woche sind möglich." },
  { icon: "🗓️", title: "Eigene Planung", desc: "Du planst Termine, Pausen und Puffer auf Vertrauensbasis selbst; regelmäßige Überstunden sowie Wochenend- und Feiertagsarbeit sind nicht vorgesehen; Ausnahmen werden ausgeglichen." },
  { icon: "📱", title: "iPad und Material", desc: "iPad mit iPrax und benötigter Software, auch privat nutzbar, plus benötigtes Therapiematerial." },
  { icon: "🚗", title: "Parken und Verpflegung", desc: "Nach Möglichkeit Parkplatz, sonst Parkkostenunterstützung; dazu kostenlose Snacks, Getränke und Küche." },
];
---

<Layout
  title="Logopäd:in / Sprachtherapeut:in (m/w/d) in Duisburg | #TeamSimsek"
  description="Mehrere unbefristete Stellen für Logopäd:innen und Sprachtherapeut:innen in Duisburg: 22–26 € brutto pro Stunde, 38,5 Stunden Vollzeit, variable Teilzeit und Vier-Tage-Woche."
  additionalSchemas={[jobSchema, breadcrumbSchema]}
  hreflangAlternates={[
    { lang: 'de', url: `${siteUrl}/karriere/` },
    { lang: 'tr', url: `${siteUrl}/kariyer/` },
    { lang: 'x-default', url: `${siteUrl}/karriere/` },
  ]}
>
  <Header alternateUrl="/kariyer/" />
  <Nav alternateUrl="/kariyer/" />
  <main id="main-content" class="pt-[calc(var(--header-h)+var(--nav-h))]">

    <!-- Breadcrumb -->
    <nav class="bg-bg-alt border-b border-border" aria-label="Breadcrumb">
      <div class="container py-3">
        <ol class="flex items-center gap-2 text-sm text-text-muted flex-wrap" role="list">
          <li><a href="/" class="hover:text-primary transition-colors">Startseite</a></li>
          <li aria-hidden="true"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg></li>
          <li class="text-text font-medium" aria-current="page">Karriere</li>
        </ol>
      </div>
    </nav>

    <!-- Bento Grid -->
    <section class="container py-10 pb-16">
      <div class="bento-grid">

        <!-- HERO CARD -->
        <div class="bento-card bento-hero">
          <div class="bento-hero__tags">
            <span class="tag tag--green">Duisburg</span>
            <span class="tag tag--green">Voll- / Teilzeit</span>
            <span class="tag tag--green">4-Tage-Woche</span>
            <span class="tag tag--green">22–26 € / Stunde</span>
            <span class="tag tag--accent">Mehrere Stellen offen</span>
          </div>
          <h1 class="bento-hero__title"><span class="sr-only">Logopädin / Logopäde / Sprachtherapeutin / Sprachtherapeut (m/w/d) gesucht – Praxis für Logopädie Şimşek Duisburg: </span>Karriere bei #TeamSimsek</h1>
          <p class="bento-hero__subtitle">Wir suchen mehrere Logopäd:innen und Sprachtherapeut:innen für unbefristete Stellen in Duisburg-Mitte – mit 22–26 € brutto pro Stunde, je nach Erfahrung.</p>
          <a href={applyHref} class="bento-cta-btn">
            Jetzt bewerben
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 14 0M12 5l7 7-7 7"/></svg>
          </a>
          <div class="bento-hero__deco" aria-hidden="true"></div>
        </div>

        <!-- ÜBER UNS CARD -->
        <div class="bento-card bento-about">
          <div class="bento-section-tag bento-section-tag--accent">Über uns</div>
          <h2 class="bento-card__title">Praxis für Logopädie Şimşek</h2>
          <p class="bento-about__text">
            Etablierte Logopädiepraxis in Duisburg-Mitte mit über zehn Jahren Erfahrung.
            Eine Praxis in der Region mit zweisprachigem Angebot auf Deutsch und Türkisch.
          </p>
          <div class="bento-about__tag-row">
            <span class="mini-tag">Frühförderung</span>
            <span class="mini-tag">Erwachsene</span>
            <span class="mini-tag">DE/TR</span>
            <span class="mini-tag">Hausbesuche</span>
          </div>
        </div>

        <!-- ANFORDERUNGEN CARD -->
        <div class="bento-card bento-requirements">
          <div class="bento-section-tag">Was wir uns wünschen</div>
          <h2 class="bento-card__title">Dein Profil</h2>
          <ul class="req-list">
            <li>
              <span class="req-check">✓</span>
              <span>Staatlich anerkannte und zugelassene Ausbildung oder Studium in Logopädie beziehungsweise Sprachtherapie</span>
            </li>
            <li>
              <span class="req-check">✓</span>
              <span>Sehr gute Deutschkenntnisse</span>
            </li>
            <li>
              <span class="req-check">✓</span>
              <span>Interesse an eigenständiger Therapie- und Terminplanung</span>
            </li>
            <li>
              <span class="req-check">✓</span>
              <span>Eigene Sprachen und fachliche Interessen sind willkommen, aber keine Voraussetzung</span>
            </li>
          </ul>
          <p class="req-welcome">Berufsanfänger:innen sind ausdrücklich willkommen.</p>
        </div>

        <!-- BENEFITS CARD (unified) -->
        <div class="bento-card bento-benefits-all">
          <div class="bento-benefits-all__header">
            <div class="bento-section-tag">Was wir bieten</div>
            <h2 class="bento-card__title bento-card__title--large">Deine Vorteile</h2>
          </div>
          <div class="benefits-inner-grid">
            {benefits.map((b, i) => (
              <div class={`benefit-item benefit-item--${i}`}>
                <span class="benefit-icon" aria-hidden="true">{b.icon}</span>
                <h3 class="benefit-title">{b.title}</h3>
                <p class="benefit-desc">{b.desc}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- PORTAL BRIDGE CARD -->
        <div class="bento-card bento-portal">
          <div class="bento-portal__left">
            <div class="bento-section-tag bento-section-tag--accent">Karriereportal</div>
            <h2 class="bento-card__title">Mehr Details zur Stelle</h2>
            <p class="bento-portal__text">
              Gehaltsrechner, Bewerbertipps und direkte Kontaktaufnahme - alles gebündelt auf LogopädieJobs.de, unserem Karriereportal für die Stelle.
            </p>
            <a
              href="https://xn--logopdiejobs-kcb.de/?utm_source=logopaedie-simsek.de&utm_medium=karriere&utm_campaign=portal-bridge"
              class="portal-link-btn"
              target="_blank"
              rel="noopener"
            >
              Zu LogopädieJobs.de
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
            </a>
          </div>
          <div class="bento-portal__features">
            <div class="portal-feature">
              <span class="portal-feature__icon" aria-hidden="true">🧮</span>
              <span class="portal-feature__label">Gehaltsrechner</span>
            </div>
            <div class="portal-feature">
              <span class="portal-feature__icon" aria-hidden="true">📖</span>
              <span class="portal-feature__label">Ratgeber & FAQs</span>
            </div>
            <div class="portal-feature">
              <span class="portal-feature__icon" aria-hidden="true">📞</span>
              <span class="portal-feature__label">Direkter Kontakt</span>
            </div>
            <div class="portal-feature">
              <span class="portal-feature__icon" aria-hidden="true">📅</span>
              <span class="portal-feature__label">4-Tage-Woche-Infos</span>
            </div>
          </div>
        </div>

        <!-- ARBEITSALLTAG CARD -->
        <div class="bento-card bento-note">
          <div class="bento-note__inner">
            <div>
              <h2 class="bento-note__title">Dein Arbeitsalltag</h2>
              <p class="bento-note__text">Du behandelst Menschen aller Altersgruppen und setzt eigene fachliche Schwerpunkte. Therapieeinheiten dauern je nach Verordnung 30, 45 oder 60 Minuten. Dokumentation, Berichte und Organisation sind eingeplante Arbeitszeit. Hausbesuche sind keine Voraussetzung und nur auf deinen Wunsch möglich.</p>
            </div>
          </div>
        </div>

        <!-- BEWERBUNG CTA CARD -->
        <div class="bento-card bento-apply">
          <div class="bento-apply__deco" aria-hidden="true"></div>
          <div class="bento-apply__layout">

            <!-- Left: Headline + CTAs -->
            <div class="bento-apply__left">
              <div class="bento-section-tag bento-section-tag--light">Bewerbung</div>
              <h2 class="bento-apply__title">Jetzt durchstarten</h2>
              <p class="bento-apply__sub">Drei Felder reichen – ein Lebenslauf ist freiwillig. Du kannst dich außerdem telefonisch, per E-Mail oder per Post melden.</p>
              <BewerbungForm labels={formLabels} mailSubject="Unverbindliches Kennenlernen – Logopädie / Sprachtherapie" />
              <div class="bento-apply__actions" hidden>
                <a href={applyHref} class="apply-btn apply-btn--primary">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                  Bewerbung senden
                </a>
                <a href="tel:+4920334868690" class="apply-btn apply-btn--outline">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.36 12 19.79 19.79 0 0 1 1.15 3.4 2 2 0 0 1 3.12 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.09 8.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21 16z"/></svg>
                  0203 – 34 86 86 90
                </a>
              </div>
            </div>

            <!-- Right: Contact card -->
            <div class="bento-apply__right">
              <div class="bento-apply__contact-card">
                <div class="bento-apply__contact-header">
                  <div class="bento-apply__avatar" aria-hidden="true">EŞ</div>
                  <div>
                    <div class="bento-apply__name">Emel Şimşek-Uçar</div>
                    <div class="bento-apply__role">Praxisinhaberin · Ansprechpartnerin</div>
                  </div>
                </div>
                <div class="bento-apply__contact-rows">
                  <div class="contact-row">
                    <svg class="contact-row__ico" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                    <span>Tonhallenstraße 21, 47051 Duisburg</span>
                  </div>
                  <div class="contact-row">
                    <svg class="contact-row__ico" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.36 12 19.79 19.79 0 0 1 1.15 3.4 2 2 0 0 1 3.12 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.09 8.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21 16z"/></svg>
                    <span>0203 – 34 86 86 90</span>
                  </div>
                  <div class="contact-row">
                    <svg class="contact-row__ico" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                    <span>info@logopaedie-simsek.de</span>
                  </div>
                </div>
              </div>
            </div>

          </div>
        </div>

        <!-- PRAKTIKUM — volle Zeile -->
        <div class="bento-card bento-note">
          <div class="bento-note__inner">
            <svg class="bento-note__ico" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
            <div>
              <h3 class="bento-note__title">Praktikumsplätze</h3>
              <p class="bento-note__text">
                Derzeit können wir keine Praktikumsplätze für Studierende aus dem Ausland anbieten.
                Für inländische Anfragen kontaktieren Sie uns gerne direkt.
              </p>
            </div>
          </div>
        </div>

      </div>
    </section>

  </main>
  <Footer />
</Layout>

<style>
  /* ─── Bento Grid Layout ─── */
  .bento-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: auto;
    gap: 12px;
  }

  /* ─── Base Card ─── */
  .bento-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    position: relative;
    overflow: hidden;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }
  .bento-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-1px);
  }

  /* ─── Hero Card ─── */
  .bento-hero {
    grid-column: span 2;
    background: var(--color-primary);
    border-color: var(--color-primary-dark);
    padding: 2.25rem;
  }
  .bento-hero__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 1.25rem;
  }
  .tag {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 4px 12px;
    border-radius: 999px;
    letter-spacing: 0.02em;
  }
  .tag--green {
    background: rgba(255,255,255,0.18);
    color: #fff;
    border: 1px solid rgba(255,255,255,0.25);
  }
  .tag--accent {
    background: var(--color-accent);
    color: #fff;
  }
  .bento-hero__title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 600;
    color: #fff;
    line-height: 1.15;
    margin-bottom: 0.75rem;
  }
  .bento-hero__subtitle {
    font-size: 0.9375rem;
    color: rgba(255,255,255,0.78);
    line-height: 1.65;
    margin-bottom: 1.75rem;
    max-width: 42ch;
  }
  .bento-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #fff;
    color: var(--color-primary);
    font-weight: 600;
    font-size: 0.9375rem;
    padding: 0.625rem 1.375rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: background 0.18s, transform 0.18s;
  }
  .bento-cta-btn:hover {
    background: var(--color-bg-alt);
    transform: translateX(2px);
  }
  .bento-hero__deco {
    position: absolute;
    bottom: -40px;
    right: -40px;
    width: 200px;
    height: 200px;
    border-radius: 50%;
    background: rgba(255,255,255,0.06);
    pointer-events: none;
  }

  /* ─── Anforderungen Card ─── */
  .bento-requirements {
    grid-column: span 3;
  }
  .bento-section-tag {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-primary);
    background: var(--color-primary-light);
    padding: 4px 10px;
    border-radius: 6px;
    margin-bottom: 0.875rem;
  }
  .bento-section-tag--accent {
    color: var(--color-accent);
    background: var(--color-accent-light);
  }
  .bento-section-tag--light {
    color: rgba(255,255,255,0.7);
    background: rgba(255,255,255,0.15);
  }
  .bento-card__title {
