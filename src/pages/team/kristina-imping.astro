---
import TeamProfileLayout from '../../layouts/TeamProfileLayout.astro';
import kristinaImg from '../../assets/therapy/team-kristina-imping.jpg';

const siteUrl = 'https://logopaedie-simsek.de';

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Kristina Imping",
  "jobTitle": "Staatlich anerkannte Logopädin",
  "url": `${siteUrl}/team/kristina-imping/`,
  "description": "Staatlich anerkannte Logopädin in der Praxis für Logopädie Şimşek in Duisburg. Kristina Imping ist auf tiergestützte Therapie und die Behandlung von Fütterstörungen spezialisiert und bringt langjährige klinische Erfahrung mit.",
  "worksFor": {
    "@type": "MedicalOrganization",
    "name": "Praxis für Logopädie Şimşek",
    "url": siteUrl
  },
  "hasOccupation": {
    "@type": "Occupation",
    "name": "Logopädin",
    "occupationalCategory": "Therapeutin",
    "skills": "Tiergestützte Therapie, Fütterstörungen"
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Startseite", "item": `${siteUrl}/` },
    { "@type": "ListItem", "position": 2, "name": "Team", "item": `${siteUrl}/team/` },
    { "@type": "ListItem", "position": 3, "name": "Kristina Imping", "item": `${siteUrl}/team/kristina-imping/` }
  ]
};

const facts = [
  {
    icon: `<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>`,
    label: 'Qualifikation',
    value: 'Staatlich anerkannte Logopädin',
  },
  {
    icon: `<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>`,
    label: 'Schwerpunkte',
    value: 'Tiergestützte Therapie & Fütterstörungen',
  },
  {
    icon: `<circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/>`,
    label: 'Erfahrung',
    value: 'Langjährige klinische Erfahrung',
  },
  {
    icon: `<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>`,
    label: 'Standort',
    value: 'Duisburg-Mitte',
  },
];

const schwerpunkte = [
  {
    icon: `<circle cx="11" cy="4" r="2"/><circle cx="18" cy="8" r="2"/><circle cx="20" cy="16" r="2"/><path d="M9 10a5 5 0 0 1 5 5v3.5a3.5 3.5 0 0 1-6.84 1.045Q6.52 17.48 4.46 16.84A3.5 3.5 0 0 1 5.5 10Z"/>`,
    title: 'Tiergestützte Therapie',
    text: 'Einbindung von Tieren in die logopädische Therapie zur Förderung von Motivation, Kontaktaufnahme und Kommunikation',
  },
  {
    icon: `<path d="M9 2h6"/><path d="M10 2v3.5a2.5 2.5 0 0 1-.732 1.768L8.5 8.036A2.5 2.5 0 0 0 7.5 10v9a2 2 0 0 0 2 2h5a2 2 0 0 0 2-2v-9a2.5 2.5 0 0 0-1-1.964l-.768-.768A2.5 2.5 0 0 1 14 5.5V2"/><path d="M7.5 14h9"/>`,
    title: 'Fütterstörungen',
    text: 'Diagnostik und Therapie bei Ess- und Fütterstörungen im Säuglings- und Kindesalter',
  },
];
---

<TeamProfileLayout
  title="Kristina Imping – Staatlich anerkannte Logopädin | Praxis für Logopädie Şimşek Duisburg"
  description="Kristina Imping, staatlich anerkannte Logopädin in der Praxis für Logopädie Şimşek in Duisburg. Schwerpunkte: tiergestützte Therapie und Fütterstörungen."
  additionalSchemas={[personSchema, breadcrumbSchema]}
  hreflangAlternates={[
    { lang: 'de', url: `${siteUrl}/team/kristina-imping/` },
    { lang: 'x-default', url: `${siteUrl}/team/kristina-imping/` },
  ]}
  name="Kristina Imping"
  heroEyebrow="Logopädin · Praxis für Logopädie Şimşek Duisburg"
  heroVariant="neutral"
  qualification="Staatlich anerkannte Logopädin"
  badges={[
    { label: 'Tiergestützte Therapie', variant: 'soft' },
    { label: 'Fütterstörungen' },
    { label: 'Langjährige Erfahrung' },
  ]}
  photo={kristinaImg}
  photoAlt="Kristina Imping – Logopädin in der Praxis für Logopädie Şimşek Duisburg"
  facts={facts}
  schwerpunkte={schwerpunkte}
>
  <Fragment slot="intro">
    <h2>Über Kristina Imping</h2>
    <p>
      Kristina Imping ist <strong>staatlich anerkannte Logopädin</strong> in der Praxis für
      Logopädie Şimşek in Duisburg und bringt langjährige klinische Erfahrung mit.
    </p>
    <p>
      Ihre fachlichen Schwerpunkte liegen in der <strong>tiergestützten Therapie</strong> sowie
      der Diagnostik und Behandlung von <strong>Fütterstörungen</strong> im Säuglings- und
      Kindesalter.
    </p>
  </Fragment>
</TeamProfileLayout>
