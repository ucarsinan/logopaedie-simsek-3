---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';
import { useTranslations } from '../i18n/index';
import emelImg from '../assets/therapy/team-emel-simsek-ucar-grid.jpg';
import maraImg from '../assets/therapy/team-mara-niessalla-grid.jpg';
import kristinaImg from '../assets/therapy/team-kristina-imping-grid.jpg';
import seymaImg from '../assets/therapy/team-seyma-bozoglan-grid.jpg';

const siteUrl = 'https://logopaedie-simsek.de';
const t = useTranslations('tr');
const page = t.team_page;

// ── Ekip veri modeli (team.astro ile aynı yapı, Türkçe içerikle) ──
type TeamMember = {
  slug: string;
  name: string;
  jobTitle: string;
  roleBadge: string;
  isLead: boolean;
  img: ImageMetadata;
  imgAlt: string;
  loading: 'eager' | 'lazy';
  tags: string[];
  schema: {
    description: string;
    hasOccupation: Record<string, unknown>;
    knowsLanguage?: Record<string, unknown>[];
    address?: Record<string, unknown>;
  };
};

const members: TeamMember[] = [
  {
    slug: 'emel-simsek-ucar',
    name: 'Emel Şimşek-Uçar',
    jobTitle: 'Dil ve Konuşma Terapisti',
    roleBadge: page.therapist_badge,
    isLead: true,
    img: emelImg,
    imgAlt: page.emel_alt,
    loading: 'eager',
    tags: [t.kontakt.info_lang_value, page.experience_chip, page.patients_chip],
    schema: {
      description: 'Praxis für Logopädie Şimşek Duisburg\'da dil ve konuşma terapisti ve muayenehanenin kurucusu. Almanca ve Türkçe iki dilli değerlendirme ve terapide uzmanlaşmıştır. 10 yılı aşkın klinik deneyime sahiptir.',
      knowsLanguage: [
        { '@type': 'Language', name: 'German' },
        { '@type': 'Language', name: 'Turkish' },
      ],
      hasOccupation: {
        '@type': 'Occupation',
        name: page.therapist_badge,
        occupationalCategory: 'Terapist',
        skills: 'Dil terapisi, ses terapisi, disfaji terapisi, erken destek, afazi terapisi, iki dilli tanı',
      },
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Tonhallenstraße 21',
        addressLocality: 'Duisburg',
        postalCode: '47051',
        addressCountry: 'DE',
      },
    },
  },
  {
    slug: 'mara-niessalla',
    name: 'Mara Nießalla',
    jobTitle: 'Dil ve Konuşma Terapisti',
    roleBadge: page.therapist_badge,
    isLead: false,
    img: maraImg,
    imgAlt: page.mara_alt,
    loading: 'lazy',
    tags: page.mara_chips,
    schema: {
      description: 'Praxis für Logopädie Şimşek Duisburg\'da dil ve konuşma terapisti. Ağırlıklı olarak yetişkin terapisi, gerektiğinde ev ziyaretleri ve çocuk ve genç terapisi sunmaktadır.',
      hasOccupation: {
        '@type': 'Occupation',
        name: page.therapist_badge,
        occupationalCategory: 'Terapist',
        skills: 'Yetişkin terapisi, ev ziyaretleri, çocuk dili terapisi, tanı, terapi planlaması',
      },
    },
  },
  {
    slug: 'kristina-imping',
    name: 'Kristina Imping',
    jobTitle: 'Dil ve Konuşma Terapisti',
    roleBadge: page.therapist_badge,
    isLead: false,
    img: kristinaImg,
    imgAlt: `Kristina Imping – Praxis für Logopädie Şimşek Duisburg'da dil ve konuşma terapisti`,
    loading: 'lazy',
    tags: ['Hayvan destekli terapi', 'Beslenme Bozukluğu', 'Uzun yıllara dayanan deneyim'],
    schema: {
      description: 'Praxis für Logopädie Şimşek Duisburg\'da dil ve konuşma terapisti. Kristina Imping, hayvan destekli terapi ve beslenme bozukluklarının tedavisinde uzmanlaşmıştır ve uzun yıllara dayanan klinik deneyime sahiptir.',
      hasOccupation: {
        '@type': 'Occupation',
        name: page.therapist_badge,
        occupationalCategory: 'Terapist',
        skills: 'Hayvan destekli terapi, beslenme bozukluğu',
      },
    },
  },
  {
    slug: 'seyma-bozoglan',
    name: 'Şeyma Bozoğlan',
    jobTitle: 'Dil ve Konuşma Terapisti',
    roleBadge: page.therapist_badge,
    isLead: false,
    img: seymaImg,
    imgAlt: `Şeyma Bozoğlan – Praxis für Logopädie Şimşek Duisburg'da dil ve konuşma terapisti`,
    loading: 'lazy',
    tags: [t.kontakt.info_lang_value, 'Çocuk Dili Terapisi', 'Afazi'],
    schema: {
      description: 'Praxis für Logopädie Şimşek Duisburg\'da dil ve konuşma terapisti. Şeyma Bozoğlan, Almanca ve Türkçe olmak üzere iki dilde (her ikisi de anadil seviyesinde) terapi vermektedir; uzmanlık alanları çocuk dili terapisi ve afazi terapisidir.',
      knowsLanguage: [
        { '@type': 'Language', name: 'German' },
        { '@type': 'Language', name: 'Turkish' },
      ],
      hasOccupation: {
        '@type': 'Occupation',
        name: page.therapist_badge,
        occupationalCategory: 'Terapist',
        skills: 'Çocuk dili terapisi, afazi terapisi, iki dilli tanı',
      },
    },
  },
];

const leadMember = members.find((m) => m.isLead) ?? members[0];

const teamSchemas = members.map((member) => ({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: member.name,
  jobTitle: member.jobTitle,
  url: `${siteUrl}/ekip/`,
  description: member.schema.description,
  worksFor: {
    '@type': 'MedicalOrganization',
    name: 'Praxis für Logopädie Şimşek',
    url: siteUrl,
  },
  ...(member.schema.knowsLanguage ? { knowsLanguage: member.schema.knowsLanguage } : {}),
  hasOccupation: member.schema.hasOccupation,
  ...(member.schema.address ? { address: member.schema.address } : {}),
}));

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": t.breadcrumb.home, "item": `${siteUrl}/anasayfa/` },
    { "@type": "ListItem", "position": 2, "name": t.nav.team, "item": `${siteUrl}/ekip/` }
  ]
};
---

<Layout
  title={page.title}
  description={page.description}
  lang="tr"
  additionalSchemas={[...teamSchemas, breadcrumbSchema]}
  hreflangAlternates={[
    { lang: 'de', url: `${siteUrl}/team/` },
    { lang: 'tr', url: `${siteUrl}/ekip/` },
    { lang: 'x-default', url: `${siteUrl}/team/` },
  ]}
>
  <Header lang="tr" alternateUrl="/team" />
  <Nav lang="tr" alternateUrl="/team" />
  <main class="pt-[calc(var(--header-h)+var(--nav-h))]">

    <!-- Breadcrumb -->
    <nav class="bg-bg-alt border-b border-border" aria-label={t.breadcrumb.aria}>
      <div class="container py-3">
        <ol class="flex items-center gap-2 text-sm text-text-muted flex-wrap" role="list">
          <li><a href="/anasayfa/" class="hover:text-primary transition-colors">{t.breadcrumb.home}</a></li>
          <li aria-hidden="true">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          </li>
          <li class="text-text font-medium" aria-current="page">{t.nav.team}</li>
        </ol>
      </div>
    </nav>

    <!-- Bento Grid -->
    <section class="container py-10 pb-16" aria-labelledby="ekip-heading">
      <h1 class="sr-only" id="ekip-heading">{page.sr_heading}</h1>
      <div class="bento">

        <!-- ── Ekip üyeleri (veri odaklı, 2–4 eşdeğer kart) ── -->
        <div class="bento-members" style={`--member-count: ${members.length};`}>
        {members.map((member) => (
          <article class="bento-member relative overflow-hidden rounded-(--radius-lg) group" aria-label={member.name}>
            <Image
              src={member.img}
              alt={member.imgAlt}
              class="bento-member-img absolute inset-0 w-full h-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-[1.04]"
              widths={[480, 720, 960]}
              sizes="(max-width: 540px) 100vw, (max-width: 860px) 50vw, 40vw"
              loading={member.loading}
              decoding="async"
            />
            <!-- Gradient overlay -->
            <div class="absolute inset-0 bg-gradient-to-t from-[#1c1916]/70 via-[#1c1916]/15 to-transparent"></div>
            <!-- Badge -->
            <div class="absolute top-5 right-5 flex flex-col items-end gap-2">
              <span class="bg-primary text-white text-[.7rem] font-bold tracking-[.06em] uppercase px-3 py-1.5 rounded-full shadow-md">
                {member.roleBadge}
              </span>
            </div>
            <!-- Content overlay -->
            <div class="absolute bottom-0 left-0 right-0 p-6">
              <h2 class="font-display text-[1.3rem] font-semibold text-white leading-tight mb-1 whitespace-nowrap overflow-hidden text-ellipsis">
                {member.name}
              </h2>
              <div class="flex flex-col items-start gap-2">
                {member.tags.map((tag) => (
                  <span class="bg-white/15 backdrop-blur-sm text-white text-xs font-medium px-3 py-1.5 rounded-full border border-white/20">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </article>
        ))}
        </div>

        <!-- ── Bilgi kartları (Başlık, İstatistik, Diller, Alıntı, Kariyer CTA) ── -->
        <div class="bento-info">

        <!-- ── Ekip Bilgisi: Başlık + Kennzahlen birleştirildi ── -->
        <div class="bento-teaminfo rounded-(--radius-lg) p-8 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6" style="background: var(--color-primary-light);">
          <div>
            <span class="text-xs font-semibold tracking-[.12em] uppercase text-primary mb-3 block">{page.title_label}</span>
            <p class="font-display text-[clamp(1.75rem,2.6vw,2.25rem)] font-semibold text-text leading-[1.15] mb-2">
              Dil ve konuşma terapisi <em class="text-primary">{page.title_emphasis}</em>
            </p>
            <p class="text-text-muted text-[0.9375rem] leading-relaxed max-w-md">
              {page.title_description}
            </p>
          </div>
          <div class="flex gap-8 shrink-0">
            <div>
              <div class="font-display text-[2.75rem] font-semibold text-primary leading-none">{members.length}</div>
              <div class="text-text-muted text-xs font-medium leading-snug mt-1">Dil ve Konuşma<br>Terapisti</div>
            </div>
            <div>
              <div class="font-display text-[2.75rem] font-semibold text-primary leading-none">2</div>
              <div class="text-text-muted text-xs font-medium leading-snug mt-1">{page.stats_languages}</div>
            </div>
          </div>
        </div>

        <!-- ── Languages card ── -->
        <div class="bento-lang rounded-(--radius-lg) p-6 flex flex-col justify-center gap-4" style="background: var(--color-bg-alt);">
          <div class="flex gap-2.5 flex-wrap">
            <span class="bg-surface border border-border text-text font-semibold text-sm px-4 py-2.5 rounded-xl shadow-sm">
              🇩🇪&nbsp; Almanca
            </span>
            <span class="bg-surface border border-border text-text font-semibold text-sm px-4 py-2.5 rounded-xl shadow-sm">
              🇹🇷&nbsp; Türkçe
            </span>
          </div>
          <p class="text-text-muted text-sm font-medium leading-relaxed">
            Almanca ve Türkçe dillerinde değerlendirme, danışmanlık ve terapi.
          </p>
        </div>

        <!-- ── Philosophy quote ── -->
        <div class="bento-phil rounded-(--radius-lg) p-7 flex flex-col justify-center" style="background: var(--color-accent-light);">
          <svg class="mb-4 shrink-0 opacity-35" width="36" height="36" viewBox="0 0 24 24" fill="var(--color-accent)" aria-hidden="true">
            <path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1zm12 0c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z"/>
          </svg>
          <blockquote class="font-display text-[1.1875rem] font-medium italic text-text leading-relaxed mb-4">
            „{page.quote}"
          </blockquote>
          <cite class="text-sm font-semibold tracking-widest uppercase not-italic" style="color: var(--color-accent);">
            {leadMember.name}
          </cite>
        </div>

        <!-- ── Career CTA ── -->
        <a href="/kariyer/" class="bento-cta rounded-(--radius-lg) p-6 flex flex-col justify-between text-white group transition-opacity hover:opacity-90" style="background: var(--color-accent);">
          <div>
            <span class="text-xs font-bold tracking-[.12em] uppercase text-white/80">{page.career_label}</span>
            <h3 class="font-display text-[1.5rem] font-semibold text-white mt-2 leading-tight">
              {page.career_heading}
            </h3>
            <p class="text-white/90 text-sm font-medium mt-2.5 leading-relaxed">
              {page.career_text}
            </p>
          </div>
          <div
            class="mt-5 inline-flex items-center justify-center gap-2 text-sm font-semibold rounded-xl px-4 py-3 transition-colors border border-white/30 group-hover:border-white/60"
            style="background: rgba(255,255,255,0.12);"
          >
            {page.job_link}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m9 18 6-6-6-6"/>
            </svg>
          </div>
        </a>

        </div>
      </div>
    </section>

    <!-- CTA Strip -->
    <div class="border-t border-border bg-bg-alt py-8">
      <div class="container flex flex-col sm:flex-row gap-3 sm:items-center sm:justify-between">
        <p class="text-text-muted text-sm">{page.cta_question}</p>
        <div class="flex flex-col sm:flex-row gap-3 shrink-0">
          <a href="/iletisim/" class="btn btn-primary justify-center">{t.kontakt.heading}</a>
          <a href="/terapi/" class="btn btn-ghost justify-center">{t.footer.links.services.label}</a>
        </div>
      </div>
    </div>

  </main>
  <Footer lang="tr" />
</Layout>

<style>
  /*
   * ── Bento grid layout ──
   * team.astro ile aynı yapı: kişi kartları için ayrı bir grid, altında 5
   * bilgi kartı için ayrı bir grid. Bu, her iki alanı da üye sayısından
   * (2–4) bağımsız ve öngörülebilir tutar.
   */
  .bento-members {
    display: grid;
    grid-template-columns: repeat(var(--member-count, 4), 1fr);
    gap: 12px;
    margin-bottom: 12px;
  }

  .bento-member {
    min-height: 460px;
  }

  .bento-info {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  .bento-teaminfo { grid-column: 1 / -1; }

  @media (max-width: 860px) {
    .bento-members {
      grid-template-columns: repeat(2, 1fr);
    }
    .bento-member {
      min-height: 340px;
    }
    .bento-info {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 540px) {
    .bento-members {
      grid-template-columns: 1fr;
    }
    .bento-member {
      min-height: 380px;
    }
    .bento-info {
      grid-template-columns: 1fr;
    }
  }
</style>
