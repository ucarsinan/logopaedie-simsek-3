---
import { Image } from 'astro:assets';
import { useTranslations } from '../../i18n/index';
import emelImg from '../../assets/therapy/team-emel-simsek-ucar-grid.jpg';
import maraImg from '../../assets/therapy/team-mara-niessalla-grid.jpg';
import kristinaImg from '../../assets/therapy/team-kristina-imping-grid.jpg';
import seymaImg from '../../assets/therapy/team-seyma-bozoglan-grid.jpg';

interface Props {
  lang?: 'de' | 'tr';
}

const { lang = 'de' } = Astro.props;
const t = useTranslations(lang).team;
const karriereHref = lang === 'tr' ? '/kariyer/' : '#karriere';
const teamHref = lang === 'tr' ? '/ekip/' : '/team/';

const memberData = [
  { initials: 'EŞ', name: 'Emel Şimşek-Uçar', isLead: true, photo: emelImg },
  { initials: 'MN', name: 'Mara Nießalla', photo: maraImg },
  { initials: 'KI', name: 'Kristina Imping', photo: kristinaImg },
  { initials: 'ŞB', name: 'Şeyma Bozoğlan', photo: seymaImg },
];

const members = memberData.map((m, i) => ({ ...m, ...t.members[i] }));
---

<section class="py-20 max-[640px]:py-14 bg-bg" id="team" aria-labelledby="team-heading">
  <div class="container">
    <header class="text-center mb-14 max-[640px]:mb-10 flex flex-col items-center gap-4 max-[640px]:gap-3">
      <span class="text-xs font-semibold tracking-widest uppercase text-primary reveal">{t.section_label}</span>
      <h2 class="font-display text-[clamp(1.85rem,4vw,2.75rem)] max-[640px]:text-[clamp(1.6rem,8vw,2.1rem)] font-semibold leading-[1.15] text-text reveal reveal-delay-1" id="team-heading">#TeamSimsek</h2>
      <p class="text-[1.0625rem] max-[640px]:text-[0.97rem] text-text-muted leading-[1.7] max-[640px]:leading-[1.65] max-w-150 reveal reveal-delay-2">{t.description}</p>
    </header>
    <div class="grid grid-cols-4 gap-6 max-[1000px]:grid-cols-2 max-[540px]:grid-cols-1 max-[640px]:gap-4">
      {members.map((member, index) => (
        <article class={`group bg-surface border border-border rounded-md max-[640px]:rounded-[20px] overflow-hidden shadow-sm transition-[transform,box-shadow] duration-250 ease-out hover:-translate-y-1 hover:shadow-md reveal${index === 0 ? '' : ` reveal-delay-${index}`}`}>
          <div class="h-65 max-[640px]:h-58 relative overflow-hidden bg-surface-2">
            {member.photo
              ? <Image
                  src={member.photo}
                  alt={`${member.name} – Logopädin in der Praxis für Logopädie Şimşek Duisburg`}
                  class="w-full h-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-[1.03]"
                  widths={[320, 480]}
                  sizes="(max-width: 540px) 100vw, (max-width: 1000px) 50vw, 25vw"
                  loading="lazy"
                  decoding="async"
                />
              : <div class="w-full h-full flex items-center justify-center">
                  <div class="w-20 h-20 rounded-full bg-primary text-white flex items-center justify-center font-display text-[1.75rem] font-semibold">{member.initials}</div>
                </div>
            }
            {member.badge && (
              <span class="absolute top-4 right-4 bg-accent text-white text-[.7rem] font-bold tracking-[.06em] uppercase px-2.5 py-1 rounded-full">{member.badge}</span>
            )}
          </div>
          <div class="p-6 max-[640px]:p-5">
            <h3 class="font-display text-[1.1875rem] max-[640px]:text-[1.1rem] font-semibold mb-1 text-text">{member.name}</h3>
            <p class="text-sm text-primary font-semibold mb-2.5">{member.role}</p>
            <p class="text-[.8125rem] max-[640px]:text-[0.78rem] text-text-muted leading-[1.5]">{member.extra}</p>
          </div>
        </article>
      ))}
    </div>
    <div class="mt-10 max-[640px]:mt-8 text-center reveal reveal-delay-4">
      <a href={teamHref} class="btn btn-primary">{t.view_all}</a>
    </div>
    <div class="mt-8 max-[640px]:mt-6 bg-[linear-gradient(135deg,var(--color-accent-light),var(--color-primary-light))] border-2 border-dashed border-border rounded-md max-[640px]:rounded-[20px] p-6 max-[640px]:p-5 flex items-center justify-between gap-6 max-[720px]:flex-col max-[720px]:items-center max-[720px]:text-center reveal reveal-delay-5">
      <div>
        <h3 class="font-display text-[1.1875rem] max-[640px]:text-[1.1rem] font-semibold mb-1 text-text">{t.join_heading}</h3>
        <p class="text-sm text-text-muted leading-[1.5]">{t.join_text}</p>
      </div>
      <a href={karriereHref} class="btn btn-accent text-sm py-[10px] px-5 shrink-0 max-[640px]:w-full max-[640px]:justify-center">{t.join_cta}</a>
    </div>
  </div>
  <div class="block w-full overflow-hidden leading-0 [&_svg]:block [&_svg]:w-full mt-14 max-[640px]:mt-10" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 60" preserveAspectRatio="none">
      <path d="M0,40 C480,0 960,60 1440,20 L1440,60 L0,60 Z" fill="#F3EDE5"/>
    </svg>
  </div>
</section>
