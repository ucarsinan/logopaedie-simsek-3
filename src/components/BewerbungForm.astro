---
/**
 * Schlankes Bewerbungsformular (3 Felder, kein CV-Upload).
 * Versand über Web3Forms (PUBLIC_WEB3FORMS_KEY). Ohne Key: Fallback auf E-Mail-Programm.
 * Gestaltet für die dunkle Apply-Karte der Karriereseite.
 */
interface Labels {
  name: string;
  contact: string;
  message: string;
  submit: string;
  sending: string;
  success_title: string;
  success_text: string;
  error_text: string;
  privacy_before: string;
  privacy_link: string;
}

interface Props {
  labels: Labels;
  mailSubject: string;
}

const { labels, mailSubject } = Astro.props;
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
---

<form class="bf" data-bewerbung-form data-mail-subject={mailSubject} novalidate>
  {accessKey && <input type="hidden" name="access_key" value={accessKey} />}
  <input type="hidden" name="subject" value={mailSubject} />
  <input type="hidden" name="from_name" value="Karriereseite logopaedie-simsek.de" />
  <input type="checkbox" name="botcheck" class="bf__honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <div class="bf__field">
    <label for="bf-name">{labels.name} *</label>
    <input id="bf-name" name="name" type="text" required autocomplete="name" />
  </div>
  <div class="bf__field">
    <label for="bf-contact">{labels.contact} *</label>
    <input id="bf-contact" name="kontakt" type="text" required autocomplete="email" inputmode="email" />
  </div>
  <div class="bf__field">
    <label for="bf-message">{labels.message}</label>
    <textarea id="bf-message" name="nachricht" rows="4"></textarea>
  </div>

  <p class="bf__privacy">
    {labels.privacy_before} <a href="/datenschutz/">{labels.privacy_link}</a>.
  </p>

  <button type="submit" class="bf__submit" data-label={labels.submit} data-sending={labels.sending}>
    {labels.submit}
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 14 0M12 5l7 7-7 7"/></svg>
  </button>

  <p
    class="bf__status"
    role="status"
    aria-live="polite"
    data-success-title={labels.success_title}
    data-success-text={labels.success_text}
    data-error-text={labels.error_text}
    hidden
  ></p>

</form>

<style>
  .bf {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }
  .bf__honeypot {
    position: absolute;
    left: -9999px;
    opacity: 0;
    pointer-events: none;
  }
  .bf__field {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .bf__field label {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: rgba(255, 255, 255, 0.65);
  }
  .bf__field input,
  .bf__field textarea {
    width: 100%;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: var(--radius-sm);
    padding: 0.6rem 0.8rem;
    font-size: 0.9375rem;
    font-family: var(--font-body);
    color: #fff;
    transition: border-color 0.18s ease, background 0.18s ease;
  }
  .bf__field input::placeholder,
  .bf__field textarea::placeholder {
    color: rgba(255, 255, 255, 0.35);
  }
  .bf__field input:focus,
  .bf__field textarea:focus {
    outline: none;
    border-color: var(--color-primary);
    background: rgba(255, 255, 255, 0.1);
  }
  .bf__field textarea {
    resize: vertical;
    min-height: 90px;
  }
  .bf__privacy {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.5);
    line-height: 1.5;
  }
  .bf__privacy a {
    color: rgba(255, 255, 255, 0.75);
    text-decoration: underline;
  }
  .bf__submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    align-self: flex-start;
    background: var(--color-primary);
    color: #fff;
    border: none;
    cursor: pointer;
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 600;
    padding: 0.7rem 1.5rem;
    border-radius: var(--radius-sm);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
    transition: background-color 0.18s ease, transform 0.18s ease;
  }
  .bf__submit:hover:not(:disabled) {
    background: var(--color-primary-dark);
    transform: translateY(-1px);
  }
  .bf__submit:disabled {
    opacity: 0.6;
    cursor: wait;
  }
  .bf__status {
    font-size: 0.9rem;
    line-height: 1.55;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-sm);
  }
  .bf__status[data-state='success'] {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #fff;
  }
  .bf__status[data-state='success'] strong {
    display: block;
    margin-bottom: 0.2rem;
  }
  .bf__status[data-state='error'] {
    background: rgba(155, 82, 52, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #fff;
  }
</style>

<script>
  function initBewerbungForms() {
    document.querySelectorAll<HTMLFormElement>('[data-bewerbung-form]').forEach((form) => {
      if (form.dataset.ready === 'true') return;
      form.dataset.ready = 'true';

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!form.reportValidity()) return;

        const status = form.querySelector<HTMLElement>('.bf__status');
        const submit = form.querySelector<HTMLButtonElement>('.bf__submit');
        if (!status || !submit) return;

        const data = new FormData(form);
        const name = String(data.get('name') ?? '');
        const kontakt = String(data.get('kontakt') ?? '');
        const nachricht = String(data.get('nachricht') ?? '');

        // Ohne Web3Forms-Key: Fallback auf das E-Mail-Programm
        if (!form.querySelector('input[name="access_key"]')) {
          const subject = form.dataset.mailSubject ?? 'Bewerbung';
          const body = `Name: ${name}\nKontakt: ${kontakt}\n\n${nachricht}`;
          window.location.href = `mailto:info@logopaedie-simsek.de?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
          return;
        }

        submit.disabled = true;
        submit.textContent = submit.dataset.sending ?? '…';

        try {
          const response = await fetch('https://api.web3forms.com/submit', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify(Object.fromEntries(data)),
          });
          const result = await response.json();
          if (!result.success) throw new Error('web3forms error');

          form
            .querySelectorAll<HTMLElement>('.bf__field, .bf__privacy, .bf__submit')
            .forEach((el) => (el.hidden = true));
          status.dataset.state = 'success';
          status.innerHTML = `<strong>${status.dataset.successTitle ?? ''}</strong>${status.dataset.successText ?? ''}`;
          status.hidden = false;
        } catch {
          status.dataset.state = 'error';
          status.textContent = status.dataset.errorText ?? '';
          status.hidden = false;
          submit.disabled = false;
          submit.textContent = submit.dataset.label ?? '';
        }
      });
    });
  }

  document.addEventListener('astro:page-load', initBewerbungForms);
  initBewerbungForms();
</script>
