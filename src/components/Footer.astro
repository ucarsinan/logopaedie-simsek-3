---
import { useTranslations } from '../i18n/index';

interface Props {
  lang?: 'de' | 'tr';
}

const { lang = 'de' } = Astro.props;
const t = useTranslations(lang).footer;
const year = new Date().getFullYear();
const socialLinks = [
  { label: 'Facebook', href: 'https://www.facebook.com/logopaediesimsek/' },
  { label: 'Instagram', href: 'https://www.instagram.com/logopaediesimsek/' },
  { label: 'YouTube', href: 'https://www.youtube.com/@logopaediesimsek' },
  { label: 'TikTok', href: 'https://www.tiktok.com/@logopaediesimsek' },
  { label: 'X', href: 'https://x.com/logosimsek' },
];

// Decorative navigation icons share the contact icons' line weight.
const pageIconPaths: Record<string, string> = {
  services: 'M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z',
  tuerkische: 'M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9H13a8.5 8.5 0 0 1 8 8v.5Z M8 10h8M8 14h5',
  insurance: 'M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11Z M8 12l3 3 5-6',
  team: 'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2 M22 21v-2a4 4 0 0 0-3-3.9 M16 3.1a4 4 0 0 1 0 7.8 M13 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z',
  karriere: 'M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2 M3 6h18v15H3Z M3 11a24 24 0 0 0 18 0 M12 10v4',
  contact: 'm7 3 3 5-3 3a16 16 0 0 0 6 6l3-3 5 3-1 4C11 22 2 13 3 4Z',
};

// Inline vector icons: no third-party scripts or requests.
const iconPaths: Record<string, string> = {
  Facebook: 'M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.413c0-3.025 1.792-4.697 4.533-4.697 1.312 0 2.686.236 2.686.236v2.972H15.83c-1.49 0-1.956.931-1.956 1.887v2.262h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073Z',
  Instagram: 'M7 0h10a7 7 0 0 1 7 7v10a7 7 0 0 1-7 7H7a7 7 0 0 1-7-7V7a7 7 0 0 1 7-7Zm0 2a5 5 0 0 0-5 5v10a5 5 0 0 0 5 5h10a5 5 0 0 0 5-5V7a5 5 0 0 0-5-5H7Zm5 4a6 6 0 1 1 0 12 6 6 0 0 1 0-12Zm0 2a4 4 0 1 0 0 8 4 4 0 0 0 0-8Zm6.5-4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3Z',
  YouTube: 'M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.121 2.136c1.872.505 9.377.505 9.377.505s7.505 0 9.376-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814ZM9.545 15.568V8.432L15.818 12l-6.273 3.568Z',
  TikTok: 'M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07Z',
  X: 'M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.64 7.584H.47l8.6-9.835L0 1.154h7.594l5.243 6.932 6.064-6.933Zm-1.29 19.49h2.039L6.487 3.24H4.3l13.31 17.403Z',
};
---

<footer class="site-footer" role="contentinfo">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-panel footer-contact">
        <p class="footer-name">Praxis für Logopädie Şimşek</p>
        <p class="footer-tagline">{t.tagline}</p>
        <address>
          <span class="footer-detail"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z" /><circle cx="12" cy="10" r="2.5" /></svg><span>Tonhallenstraße 21<br />47051 Duisburg</span></span>
          <span><a href="tel:+4920334868690" class="footer-detail"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m7 3 3 5-3 3a16 16 0 0 0 6 6l3-3 5 3-1 4C11 22 2 13 3 4Z" /></svg><span>Tel. 0203 – 34 86 86 90</span></a><span class="footer-detail"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M6 8V3h12v5M6 17H3V8h18v9h-3M6 14h12v7H6Z" /><path d="M17 11h1" /></svg><span>Fax 0203 – 34 86 86 91</span></span></span>
        </address>
      </div>
      <nav class="footer-panel" aria-label={t.nav_label}>
        <div class="footer-navigation">
          {Object.entries(t.links).map(([key, link]) => <a href={link.href}><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={pageIconPaths[key]} /></svg><span>{link.label}</span></a>)}
        </div>
      </nav>
      <div class="footer-panel footer-social">
        <ul>
          {socialLinks.map(({ label, href }) => (
            <li><a href={href} target="_blank" rel="noopener noreferrer" aria-label={label} title={label}>
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path fill="currentColor" fill-rule="evenodd" d={iconPaths[label]} /></svg>
            </a></li>
          ))}
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; {year} Praxis für Logopädie Şimşek · Emel Şimşek-Uçar · {t.copyright}</p>
      <div class="footer-legal">
        <a href="/impressum/">Impressum</a>
        <a href="/datenschutz/">{t.privacy}</a>
        <a href="/barrierefreiheit/">{t.accessibility}</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--color-text, #1c1916); color: rgb(255 255 255 / 76%); padding: 24px 0 12px; }
  .footer-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) 94px; gap: 8px; }
  .footer-panel { min-width: 0; padding: 12px 16px; border: 1px solid rgb(255 255 255 / 14%); border-radius: 16px; background: rgb(255 255 255 / 4%); }
  .footer-name { font-family: var(--font-display); font-size: 1.125rem; line-height: 1.35; color: white; }
  .footer-tagline { margin-top: 4px; font-size: .8125rem; line-height: 1.5; }
  address { display: flex; flex-wrap: wrap; align-items: start; gap: 4px 24px; margin-top: 8px; font-style: normal; font-size: .8125rem; line-height: 1.6; }
  .footer-detail { display: flex; align-items: center; gap: 6px; }
  a.footer-detail { min-height: 24px; }
  .footer-detail > svg, .footer-navigation svg { flex: none; }
  .footer-navigation { display: grid; grid-template-columns: 1fr 1fr; column-gap: 16px; align-items: start; align-content: start; }
  .footer-navigation a { gap: 6px; font-size: .8125rem; line-height: 1.4; min-height: 28px; padding: 2px 0; }
  a { display: inline-flex; align-items: center; min-height: 44px; min-width: 44px; color: inherit; text-decoration: none; border-radius: 8px; }
  a:hover { color: var(--color-primary-light, #e6f4f1); text-decoration: underline; text-underline-offset: 4px; }
  a:focus-visible { outline: 2px solid var(--color-primary-light, #e6f4f1); outline-offset: 3px; background: var(--color-primary-dark, #1f6056); color: white; }
  .footer-social { padding: 12px; }
  .footer-social ul { display: grid; grid-template-columns: repeat(2, 32px); gap: 0 4px; list-style: none; padding: 0; margin: 0; }
  .footer-social a { width: 32px; height: 32px; min-width: 32px; min-height: 32px; justify-content: center; color: white; }
  .footer-social a:hover { background: var(--color-primary-dark, #1f6056); }
  .footer-social svg { width: 16px; height: 16px; }
  .footer-bottom { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0 24px; margin-top: 8px; font-size: .75rem; line-height: 1.6; }
  .footer-legal { display: flex; flex-wrap: wrap; gap: 0 16px; }
  @media (min-width: 641px) and (max-width: 959px) {
    .footer-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) 70px; }
    .footer-social ul { grid-template-columns: 32px; }
  }
  @media (max-width: 640px) {
    .site-footer { padding: 16px 0 8px; }
    .footer-grid { grid-template-columns: 1fr; }
    .footer-panel { padding: 8px 12px; }
    .footer-name { font-size: 1.0625rem; }
    address { gap: 4px 16px; }
    .footer-navigation { column-gap: 12px; }
    .footer-navigation a { min-height: 32px; }
    .footer-social { padding: 4px 12px; }
    .footer-social a { width: 44px; height: 44px; min-width: 44px; min-height: 44px; }
    .footer-social ul { display: flex; flex-wrap: wrap; gap: 4px; }
    .footer-bottom { margin-top: 8px; font-size: .6875rem; }
    .footer-legal { gap: 0 12px; }
  }
</style>
